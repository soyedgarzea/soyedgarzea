{
  "name": "soyedgarzea",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "branch:protect": "node ./scripts/run-protected-branch-check.mjs",
    "commit:verify": "node ./scripts/run-commit-msg-check.mjs",
    "staged:check": "node ./scripts/run-staged-checks.mjs",
    "workflow:lint": "node ./scripts/run-workflow-lint.mjs",
    "validate": "node ./scripts/run-quality-checks.mjs",
    "check": "pnpm validate"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.41",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
